{
  "name": "idle-fish",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "铝型材机柜报价工具",
  "scripts": {
    "dev": "pnpm --filter @idle-fish/shared build && concurrently -n server,client -c blue,magenta \"pnpm --filter @idle-fish/server dev\" \"pnpm --filter @idle-fish/client dev\"",
    "dev:server": "pnpm --filter @idle-fish/server dev",
    "dev:client": "pnpm --filter @idle-fish/client dev",
    "build": "pnpm --filter @idle-fish/shared build && pnpm --filter @idle-fish/client build && pnpm --filter @idle-fish/server build",
    "start": "pnpm --filter @idle-fish/server start",
    "test": "pnpm --filter @idle-fish/shared test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "1.62.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "nanoid@^3": "^3.3.18"
    }
  }
}
